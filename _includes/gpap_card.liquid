<div class="gpap-card">
  <a class="gpap-card-icon" href="https://github.com/yogevshalmon/gpap">
    <img
      src="{{ '/assets/img/gpap/gpap_icon.png' | relative_url }}"
      width="48"
      height="48"
      alt="GPAP logo: a 3x3 grid of purple cells inside a chip die with gold pins"
    >
  </a>
  <div class="gpap-card-body">
    <div class="gpap-card-title">
      <a href="https://github.com/yogevshalmon/gpap">GPAP</a>
      <span class="gpap-card-subtitle">GPU-Parallel (partial) Assignment Propagation</span>
    </div>
    <p class="gpap-card-text">
      Boolean constraint propagation on the GPU: thousands of independent partial assignments, each propagated to its own fixpoint in a single kernel
      launch. A foundation for SAT on the GPU, and an open-source library to build on.
    </p>
    <div class="gpap-card-links">
      <a href="https://github.com/yogevshalmon/gpap" class="btn btn-sm z-depth-0" role="button">Code</a>
      <a href="https://arxiv.org/abs/2610.28805" class="btn btn-sm z-depth-0" role="button">arXiv</a>
      <a href="https://github.com/yogevshalmon/gpap/tree/main/docs" class="btn btn-sm z-depth-0" role="button">Docs</a>
    </div>
  </div>
</div>
